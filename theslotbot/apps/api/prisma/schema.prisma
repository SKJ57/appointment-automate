// ─────────────────────────────────────────────────────────────────────────────
// theslotbot — Production Prisma Schema
// Version: 1.0 — Phase 1
//
// Design decisions in this file:
//   Every table has created_at / updated_at (audit baseline).
//   All monetary values are stored as integer paise (1 INR = 100 paise)
//     to avoid floating point error.
//   All timestamps are DateTime with @db.Timestamptz (timezone-aware).
//     Risk B4: timezone must be handled at query time using the salon's
//     configured timezone from CLIENT_CONFIG, not assumed UTC.
//   Enum values are snake_case strings matching the shared types package.
//   Foreign keys are UUIDs generated by @default(uuid()) — never
//     client-supplied, never auto-increment integers (which leak record
//     counts and make horizontal scaling harder).
//
// Risk fixes embedded in this schema:
//   B1  — overlap check fields (slotStart, slotEnd on Booking)
//   B4  — timestamptz on every datetime field
//   C1  — idempotencyKey on MessageLog (unique constraint)
//   D1  — actualVisitDate on Booking (separate from completedAt)
//   D4  — whatsappOptIn on Customer (explicit, not defaulted true)
//   A1  — lastActivityAt + sessionVersion on ConversationSession
//   A2  — repromptCount on ConversationSession
//   A3  — sessionVersion optimistic lock on ConversationSession
//   Kill Switch — subscriptionStatus + campaignResumeAfter on Salon
//   Ghost Rule — OfflineMessageLog table
//   Auth — User + UserInvite tables linked to Supabase Auth
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// These must stay in sync with packages/shared/src/types/index.ts.
// When you add a value here, add it there first — TypeScript will
// then flag every consumer that needs updating.
// ─────────────────────────────────────────────

enum SubscriptionStatus {
  active
  suspended
  cancelled
}

enum UserRole {
  agency_admin
  salon_owner
  salon_staff
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum ServiceCategory {
  short_cycle
  medium_cycle
  long_cycle
}

enum BookingStatus {
  pending_confirmation
  confirmed
  completed
  cancelled
  no_show
}

enum BookingSource {
  whatsapp
  admin_manual
}

enum ConversationState {
  idle
  greeting
  awaiting_service_selection
  awaiting_slot_selection
  awaiting_slot_confirmation
  booking_confirmed
  awaiting_human_handoff
  expired
}

enum MessageType {
  booking_confirm
  reminder_24h
  reminder_3h
  review_request
  revisit_day30
  revisit_day37
  service_offline
}

enum TemplateCategory {
  utility
  marketing
}

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
}

enum RevisitCampaignStatus {
  none
  day30_sent
  day37_sent
  converted
  non_responder
}

// ─────────────────────────────────────────────
// SALON
//
// The root entity. Everything else belongs to a Salon.
// This is the white-label isolation boundary — in a multi-client
// deployment, no query should ever return data across Salon boundaries.
//
// Kill Switch fields:
//   subscriptionStatus   — controls the webhook gate middleware
//   lastSuspendedAt      — set when status moves to `suspended`
//   campaignResumeAfter  — set to NOW() on every reactivation.
//     The revisit campaign workers ignore any customer whose
//     last_visit_date < campaignResumeAfter, preventing retroactive
//     blasting after a long offline period.
//     Example: salon offline for 6 months, reactivates June 28.
//     campaignResumeAfter = 2025-06-28. Any customer whose 30-day
//     window fell in Jan–May is silently skipped. Only customers
//     with visits after June 28 enter the campaign cycle.
// ─────────────────────────────────────────────

model Salon {
  id   String @id @default(uuid())
  name String
  slug String @unique // URL-safe identifier, e.g. "jaya-premium-salon"

  // Contact & identity
  whatsappNumber String @unique // E.164 format, e.g. +919876543210
  googleReviewUrl String?

  // Kill Switch (Risk: Business Requirement 2)
  subscriptionStatus  SubscriptionStatus @default(active)
  lastSuspendedAt     DateTime?          @db.Timestamptz
  lastReactivatedAt   DateTime?          @db.Timestamptz
  // Workers compare customer.lastVisitDate against this timestamp.
  // Set to NOW() on every transition from suspended → active.
  // Null means the salon has never been suspended (all customers eligible).
  campaignResumeAfter DateTime?          @db.Timestamptz

  // Offline message for suspended salons
  // Configurable per client. Falls back to a system default in CLIENT_CONFIG.
  serviceOfflineMessage String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  // Relations
  users       User[]
  invites     UserInvite[]
  customers   Customer[]
  services    Service[]
  slots       Slot[]
  bookings    Booking[]
  messageLogs MessageLog[]
  sessions    ConversationSession[]
  offlineLogs OfflineMessageLog[]

  @@map("salons")
}

// ─────────────────────────────────────────────
// USER (Invite-Only Auth)
//
// This table mirrors Supabase's auth.users table by supabaseUserId.
// It does NOT store passwords or credentials — Supabase Auth owns that.
//
// How invite-only auth works:
//   1. agency_admin seeds a Salon and a salon_owner User via seed script.
//      The seed calls Supabase Admin API to create the auth user, then
//      inserts here with the returned UUID.
//   2. salon_owner invites salon_staff via the admin panel.
//      This creates a UserInvite row and sends an email with a token.
//   3. The invite link hits a public (but token-gated) endpoint.
//      On acceptance: Supabase Auth creates the user, we insert a User row.
//   4. No public /signup route exists anywhere in the codebase.
//
// salonId is nullable ONLY for agency_admin, who has cross-salon access.
// Every salon_owner and salon_staff must have a salonId.
// This is enforced in the auth middleware, not at the DB level (Prisma
// doesn't support conditional non-null constraints). Add a DB-level
// CHECK constraint in a raw migration if this becomes a compliance need.
// ─────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  // The UUID from Supabase auth.users. This is the join key used
  // to look up our User record from a Supabase JWT.
  supabaseUserId String   @unique @map("supabase_user_id")
  email          String   @unique
  name           String
  role           UserRole
  isActive       Boolean  @default(true)

  // Nullable for agency_admin only. Non-null for all salon roles.
  salonId String? @map("salon_id")
  salon   Salon?  @relation(fields: [salonId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  // Audit trail: every admin action records the acting user
  auditedBookings Booking[] @relation("BookingAuditedBy")

  @@index([salonId])
  @@map("users")
}

// ─────────────────────────────────────────────
// USER INVITE
//
// Represents a pending invitation. One row per invite sent.
//
// token           — cryptographically random, 64-char hex string.
//                   Sent in the invite URL: /invite/accept?token=...
//                   Stored as a bcrypt hash here (never plaintext).
// expiresAt       — 72 hours from creation. A nightly cron sets
//                   status = expired for all rows past this date.
// invitedByUserId — audit trail: who sent this invite.
// role            — the role the new user will receive on acceptance.
//                   salon_owner can only invite salon_staff.
//                   agency_admin can invite any role.
// ─────────────────────────────────────────────

model UserInvite {
  id              String       @id @default(uuid())
  email           String
  tokenHash       String       @unique @map("token_hash")
  role            UserRole
  status          InviteStatus @default(pending)
  expiresAt       DateTime     @db.Timestamptz

  salonId         String @map("salon_id")
  salon           Salon  @relation(fields: [salonId], references: [id])

  invitedByUserId String @map("invited_by_user_id")
  // Intentionally no FK relation to User here — if the inviter's
  // account is deactivated, we still want the audit record.

  acceptedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([salonId])
  @@index([email])
  @@map("user_invites")
}

// ─────────────────────────────────────────────
// CUSTOMER
//
// A customer is scoped to a Salon. The same human visiting two
// different salons is two separate Customer records — this is
// intentional for data isolation.
//
// whatsappOptIn (Risk D4):
//   Default is FALSE, not true.
//   The booking confirmation flow includes an explicit opt-in step.
//   Set to true only when the customer explicitly responds YES.
//   Only customers with whatsappOptIn = true receive marketing-
//   category messages (revisit campaign, review request).
//   Utility messages (booking confirmation, reminders) are sent
//   regardless of opt-in status — they relate to an existing transaction.
//
// lastVisitDate vs. actual DB completedAt (Risk D1):
//   lastVisitDate is the date of the appointment itself (slot_start::date),
//   not the timestamp when staff clicked "mark complete" in the admin panel.
//   The campaign query compares against this, ensuring a 5 PM visit
//   logged at 10 PM still counts as the correct date.
//
// lastVisitServiceId:
//   Drives service-category branching in the revisit campaign.
//   Set alongside lastVisitDate when a visit is marked complete.
// ─────────────────────────────────────────────

model Customer {
  id          String @id @default(uuid())
  phoneNumber String @map("phone_number") // E.164, unique per salon
  name        String

  salonId String @map("salon_id")
  salon   Salon  @relation(fields: [salonId], references: [id])

  // Opt-in (Risk D4) — explicit, never defaulted to true
  whatsappOptIn Boolean @default(false) @map("whatsapp_opt_in")

  // Campaign tracking (Risk D1)
  // lastVisitDate: the date of the actual appointment (slotStart::date)
  // NOT the timestamp when staff clicked "mark complete"
  lastVisitDate      DateTime? @db.Date       @map("last_visit_date")
  lastVisitServiceId String?   @map("last_visit_service_id")

  revisitCampaignStatus RevisitCampaignStatus @default(none) @map("revisit_campaign_status")
  // Counts full none→day30→day37→non_responder cycles ignored.
  // When this reaches CLIENT_CONFIG.campaign.nonResponderThreshold,
  // the customer is downgraded to annual (not quarterly) messaging.
  nonResponderCount Int @default(0) @map("non_responder_count")

  // Set when a customer's number fails with Meta error 131026.
  // All future outbound attempts to this number are blocked.
  isNumberInvalid Boolean @default(false) @map("is_number_invalid")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  // Relations
  lastVisitService  Service?              @relation(fields: [lastVisitServiceId], references: [id])
  bookings          Booking[]
  messageLogs       MessageLog[]
  sessions          ConversationSession[]
  offlineLogs       OfflineMessageLog[]

  // A customer phone number must be unique within a salon.
  // Two different salons can have the same phone number (different records).
  @@unique([salonId, phoneNumber])
  @@index([salonId])
  @@index([phoneNumber])
  @@map("customers")
}

// ─────────────────────────────────────────────
// SERVICE
//
// soft-delete via isActive — never hard-delete, to preserve
// foreign key integrity on historical booking records.
//
// price: stored as integer paise (1 INR = 100 paise).
//   Display as: (price / 100).toFixed(2)
//   Never store as Float — binary floating point cannot represent
//   1/10 exactly, and financial values must round-trip losslessly.
//
// durationMinutes: used by slot generation and the overlap check (Risk B1).
//   The overlap check uses slotStart + durationMinutes to compute slotEnd.
// ─────────────────────────────────────────────

model Service {
  id              String          @id @default(uuid())
  name            String
  description     String?
  price           Int             // in paise (100 paise = 1 INR)
  durationMinutes Int             @map("duration_minutes")
  category        ServiceCategory
  isActive        Boolean         @default(true) @map("is_active")
  displayOrder    Int             @default(0)   @map("display_order")

  salonId String @map("salon_id")
  salon   Salon  @relation(fields: [salonId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  bookings          Booking[]
  customersLastVisit Customer[]

  @@index([salonId, isActive])
  @@map("services")
}

// ─────────────────────────────────────────────
// SLOT
//
// Slots are pre-generated by the SlotGenerationWorker, which runs
// nightly and generates slots for the next CLIENT_CONFIG.booking
// .maxAdvanceBookingDays days.
//
// Slot generation is idempotent: INSERT ... ON CONFLICT DO NOTHING
// so re-running it never duplicates slots.
//
// When a slot is booked, bookingId is set atomically.
// When a booking is cancelled, bookingId is cleared back to null.
//
// isBlocked: manually set by reception (holidays, staff breaks).
// A blocked slot with a null bookingId is visible in the admin
// calendar as "unavailable" and is excluded from the availability
// query shown to WhatsApp customers.
//
// stylistId: optional in v1. When null, the salon is treated as a
// single resource. The overlap check (Risk B1) uses salonId as the
// capacity boundary when stylistId is null.
// ─────────────────────────────────────────────

model Slot {
  id        String   @id @default(uuid())
  startTime DateTime @db.Timestamptz @map("start_time")
  endTime   DateTime @db.Timestamptz @map("end_time")
  isBlocked Boolean  @default(false) @map("is_blocked")
  stylistId String?  @map("stylist_id") // nullable in v1

  salonId   String  @map("salon_id")
  salon     Salon   @relation(fields: [salonId], references: [id])
  bookingId String? @unique @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  @@index([salonId, startTime])
  @@index([salonId, isBlocked, bookingId]) // availability query index
  @@map("slots")
}

// ─────────────────────────────────────────────
// BOOKING
//
// Risk B1 — Overlap prevention:
//   slotStart and slotEnd are stored here (not just on the Slot)
//   to support the overlap query that runs inside the booking
//   creation transaction:
//
//   SELECT COUNT(*) FROM bookings
//   WHERE salonId = $salon
//     AND status NOT IN ('cancelled', 'no_show')
//     AND slotStart < $newEnd
//     AND slotEnd > $newStart
//
//   This query is run BEFORE the atomic slot update. If count > 0,
//   the booking is rejected with SLOT_OVERLAP_DETECTED.
//   Both operations run in the same Prisma transaction.
//
// Risk D1 — actualVisitDate:
//   Set to slotStart::date at booking creation time.
//   The revisit campaign query uses this, not the completedAt timestamp.
//   This ensures a 5 PM visit logged by staff at 10 PM counts correctly.
//
// Audit fields:
//   completedAt  — when staff clicked "mark complete" (admin audit)
//   completedBy  — which User performed the action (audit trail, Section 6.5)
//   cancelledAt  — when the cancellation occurred
// ─────────────────────────────────────────────

model Booking {
  id     String        @id @default(uuid())
  status BookingStatus @default(pending_confirmation)
  source BookingSource @default(whatsapp)

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id])

  salonId String @map("salon_id")
  salon   Salon  @relation(fields: [salonId], references: [id])

  // Risk B1: both stored for the overlap range check
  slotStart DateTime @db.Timestamptz @map("slot_start")
  slotEnd   DateTime @db.Timestamptz @map("slot_end")

  // Risk D1: the date of the actual appointment, used by campaign workers
  // Set at booking creation from slotStart::date. Never changed thereafter.
  actualVisitDate DateTime @db.Date @map("actual_visit_date")

  // Idempotency flags for reminder sends (Risk C1)
  // These are the second layer of dedup after MessageLog.idempotencyKey.
  reminder24hSent Boolean @default(false) @map("reminder_24h_sent")
  reminder3hSent  Boolean @default(false) @map("reminder_3h_sent")
  reviewRequestSent Boolean @default(false) @map("review_request_sent")

  // Audit trail
  completedAt   DateTime? @db.Timestamptz @map("completed_at")
  completedById String?   @map("completed_by_id")
  completedBy   User?     @relation("BookingAuditedBy", fields: [completedById], references: [id])
  cancelledAt   DateTime? @db.Timestamptz @map("cancelled_at")
  notes         String?   // Internal staff notes

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  slot        Slot?
  messageLogs MessageLog[]

  // Index for the overlap check query (Risk B1)
  @@index([salonId, status, slotStart, slotEnd])
  @@index([customerId])
  @@map("bookings")
}

// ─────────────────────────────────────────────
// CONVERSATION SESSION
//
// Stores the state of an in-progress WhatsApp conversation.
// Keyed by (salonId, customerPhoneNumber) — not customerId —
// because a new customer won't have a Customer record yet when
// their first message arrives.
//
// Risk A1 — Session timeout:
//   lastActivityAt is updated on every incoming message.
//   The session handler checks: if now() - lastActivityAt > timeout,
//   reset state to 'expired' and send "session expired, let's restart."
//
// Risk A3 — Concurrent message race condition:
//   sessionVersion is an optimistic lock. The session update query is:
//   UPDATE conversation_sessions
//   SET state = $newState, session_version = session_version + 1, ...
//   WHERE id = $id AND session_version = $knownVersion
//   If 0 rows affected, a concurrent update won the race.
//   The losing request re-reads the session and re-evaluates.
//
// Risk A2 — Reprompt loop:
//   repromptCount increments on each invalid input in a given state.
//   When it reaches CLIENT_CONFIG.conversation.maxReprompts,
//   state transitions to awaiting_human_handoff.
//   Reset to 0 on any valid state transition.
//
// selectedServiceId / selectedSlotId:
//   Temporary context held during the booking flow.
//   Cleared when a booking is confirmed or the session expires.
// ─────────────────────────────────────────────

model ConversationSession {
  id                 String            @id @default(uuid())
  customerPhoneNumber String           @map("customer_phone_number") // E.164
  state              ConversationState @default(idle)

  // Optimistic lock (Risk A3)
  sessionVersion Int @default(0) @map("session_version")

  // Timeout tracking (Risk A1)
  lastActivityAt DateTime @default(now()) @db.Timestamptz @map("last_activity_at")

  // Reprompt guard (Risk A2)
  repromptCount Int @default(0) @map("reprompt_count")

  // In-flight booking context
  selectedServiceId String? @map("selected_service_id")
  selectedSlotId    String? @map("selected_slot_id")

  salonId  String   @map("salon_id")
  salon    Salon    @relation(fields: [salonId], references: [id])
  customerId String? @map("customer_id") // null until customer record exists
  customer  Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  // A phone number has exactly one active session per salon at a time
  @@unique([salonId, customerPhoneNumber])
  @@index([salonId])
  @@map("conversation_sessions")
}

// ─────────────────────────────────────────────
// MESSAGE LOG
//
// Every outbound WhatsApp message is written here BEFORE it is sent.
// Status is updated via Meta webhook callbacks after sending.
//
// Design principle from spec Section 1.3:
//   "Every outbound message is logged before it is sent and updated
//    after — never the reverse — so a crash mid-send never produces
//    an unaccounted-for message."
//
// Risk C1 — Idempotency key (duplicate message prevention):
//   idempotencyKey is a unique index.
//   Format:
//     booking-scoped:  `${bookingId}::${messageType}`
//     customer-scoped: `${customerId}::${messageType}::${YYYY-MM-DD}`
//
//   Before sending, the worker attempts INSERT. If it fails with
//   a unique constraint violation, the message was already sent
//   (or is being sent concurrently). The duplicate is silently dropped.
//
// metaErrorCode: the numeric string from Meta (e.g. "131026", "131049").
//   Used by the retry router in gateway.ts. See META_ERROR_MAP in shared.
//
// metaMessageId: the message ID returned by Meta on successful send.
//   Used to correlate incoming status webhook callbacks back to this row.
// ─────────────────────────────────────────────

model MessageLog {
  id              String          @id @default(uuid())
  messageType     MessageType     @map("message_type")
  templateCategory TemplateCategory @map("template_category")
  status          MessageStatus   @default(queued)

  // Idempotency (Risk C1)
  idempotencyKey String @unique @map("idempotency_key")

  // Meta API fields
  metaMessageId String? @map("meta_message_id") // returned on successful send
  metaErrorCode String? @map("meta_error_code")  // e.g. "131026", "131049"

  // Status timestamps (updated via Meta webhook callbacks)
  sentAt      DateTime? @db.Timestamptz @map("sent_at")
  deliveredAt DateTime? @db.Timestamptz @map("delivered_at")
  readAt      DateTime? @db.Timestamptz @map("read_at")
  failedAt    DateTime? @db.Timestamptz @map("failed_at")

  // Relations
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  salonId String @map("salon_id")
  salon   Salon  @relation(fields: [salonId], references: [id])

  bookingId String?  @map("booking_id") // null for campaign/review messages
  booking   Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt     @db.Timestamptz

  @@index([customerId])
  @@index([salonId, messageType, status])
  @@index([metaMessageId]) // for webhook callback lookups
  @@map("message_logs")
}

// ─────────────────────────────────────────────
// OFFLINE MESSAGE LOG
//
// Business Requirement 2 — The 24-Hour Ghost Rule:
//
// When a salon is suspended, the webhook intercepts all incoming
// messages and sends the serviceOfflineMessage. To prevent API
// cost spikes from spam or persistent customers, this message
// may only be sent ONCE per customer phone number per 24 hours.
// Subsequent messages within the 24-hour window are silently dropped.
//
// This is a SEPARATE table from MessageLog for two reasons:
//   1. An offline customer may have no Customer record (new number).
//      MessageLog requires a customerId FK. This table uses phoneNumber.
//   2. The rate-limit query pattern is different from the idempotency
//      key pattern. Here we query by recency, not by exact key match.
//
// Rate-limit check logic (in subscriptionGate.ts middleware):
//   SELECT * FROM offline_message_logs
//   WHERE salon_id = $salon
//     AND customer_phone = $phone
//     AND sent_at > NOW() - INTERVAL '24 hours'
//   LIMIT 1
//
//   If a row exists → silent drop (no API call, no log write).
//   If no row → send the offline message, insert a row here.
// ─────────────────────────────────────────────

model OfflineMessageLog {
  id            String   @id @default(uuid())
  customerPhone String   @map("customer_phone") // E.164, no FK required
  sentAt        DateTime @default(now()) @db.Timestamptz @map("sent_at")

  salonId    String   @map("salon_id")
  salon      Salon    @relation(fields: [salonId], references: [id])
  // customerId is nullable — the customer may not exist in our DB yet
  customerId String?  @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  // Composite index for the rate-limit check query
  @@index([salonId, customerPhone, sentAt])
  @@map("offline_message_logs")
}
